import bpy
import json
import os

# ==========================================
# 設定
# ==========================================
OUTPUT_DIR = os.path.expanduser("~/Desktop")
OUTPUT_FILENAME = "case01_vessel_subtracted.json"  # 症例ごとに変更してください

TARGET_OBJ_NAME = "vessel_centerline_perfect"  # 対象オブジェクト名

def export_subtracted_vessel_to_json():
    # 1. オブジェクトの取得
    obj = bpy.data.objects.get(TARGET_OBJ_NAME)
    
    if not obj:
        print(f"エラー: オブジェクト '{TARGET_OBJ_NAME}' が見つかりません。")
        return

    print(f"対象オブジェクト: {obj.name} (Type: {obj.type})")

    matrix_world = obj.matrix_world
    vessel_points = []

    # 2. オブジェクトタイプに応じた座標抽出
    if obj.type == 'CURVE':
        # Curve（ちぎれた複数のPath群）の場合
        for spline in obj.data.splines:
            pts = spline.points if len(spline.points) > 0 else spline.bezier_points
            for pt in pts:
                pt_co = pt.co.xyz if hasattr(pt, 'co') and len(pt.co) == 4 else pt.co
                v_world = matrix_world @ pt_co
                vessel_points.append([round(v_world.x, 6), round(v_world.y, 6), round(v_world.z, 6)])

    elif obj.type == 'MESH':
        # Mesh（頂点群）の場合
        for v in obj.data.vertices:
            v_world = matrix_world @ v.co
            vessel_points.append([round(v_world.x, 6), round(v_world.y, 6), round(v_world.z, 6)])

    else:
        print(f"エラー: サポートされていないオブジェクトタイプです: {obj.type}")
        return

    # 3. JSONデータの構築
    data = {
        "object_name": obj.name,
        "num_points": len(vessel_points),
        "vessel_points": vessel_points
    }

    # 4. ファイル保存
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    file_path = os.path.join(OUTPUT_DIR, OUTPUT_FILENAME)
    
    with open(file_path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=4, ensure_ascii=False)

    print(f"🎉 骨除去済み血管点群データを出力しました ({len(vessel_points)}点): {file_path}")

# 実行
export_subtracted_vessel_to_json()
