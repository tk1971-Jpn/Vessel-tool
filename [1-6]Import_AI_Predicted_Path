import bpy
import json
import os

# ==========================================
# 設定
# ==========================================
JSON_PATH = "/Users/tkimura/Desktop/sma_predicted_case01.json"
OBJECT_NAME = "SMA_Predicted_AI"

def create_smooth_sma_path():
    if not os.path.exists(JSON_PATH):
        print(f"エラー: ファイルが存在しません -> {JSON_PATH}")
        return

    with open(JSON_PATH, 'r', encoding='utf-8') as f:
        data = json.load(f)

    points = data.get("sma_path_points", [])
    num_pts = len(points)

    if num_pts < 2:
        print("エラー: 頂点数が不足しています。")
        return

    # 古い同名オブジェクトを削除
    old_obj = bpy.data.objects.get(OBJECT_NAME)
    if old_obj:
        bpy.data.objects.remove(old_obj, do_unlink=True)

    # 1. 新しい Curve データの作成
    curve_data = bpy.data.curves.new(name=OBJECT_NAME, type='CURVE')
    curve_data.dimensions = '3D'
    curve_data.bevel_depth = 0.003  # 血管の太さ

    # 2. 最初から全点数(num_pts)を持った BEZIER スプラインとして作成
    spline = curve_data.splines.new('BEZIER')
    spline.bezier_points.add(num_pts - 1)  # 全頂点分を一括確保

    # 3. 座標を一括割り当て & ハンドルを AUTO(滑らか) に自動計算
    for i, pt in enumerate(points):
        bp = spline.bezier_points[i]
        # 頂点座標（スナップ点）の設定
        bp.co = (pt[0], pt[1], pt[2])
        # ハンドルタイプを AUTO に設定（各点を通るしなやかな曲線へ自動補間）
        bp.handle_left_type = 'AUTO'
        bp.handle_right_type = 'AUTO'

    # 4. オブジェクト生成とシーン追加
    obj = bpy.data.objects.new(OBJECT_NAME, curve_data)
    bpy.context.collection.objects.link(obj)
    bpy.context.view_layer.update()

    print(f"🎉 根元までしなやかなPathを作成しました ({num_pts}点一括配置)")

create_smooth_sma_path()
